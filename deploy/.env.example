# This project's Cloudflare account. Copy to deploy/.env (git-ignored) and fill in.
# `npm run deploy:site` and scripts/publish-live.mjs read it. Every deploy is pinned to this account ID.
CLOUDFLARE_ACCOUNT_ID=
# Optional: an "Edit Cloudflare Workers" API token. Without it wrangler uses this machine's `wrangler login`.
CLOUDFLARE_API_TOKEN=
# where the site reads live results: the vote-live Worker on this account's workers.dev subdomain
VITE_LIVE_URL=https://vote-live.<subdomain>.workers.dev/results.json
# Cloudflare Pages project that serves the site
PAGES_PROJECT=kaipiao
