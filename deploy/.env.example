# This project's own Cloudflare account. Copy to deploy/.env (git-ignored) and fill in.
# `npm run deploy:site` and scripts/publish-live.mjs read it; they never use this machine's `wrangler login`.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# where the site reads live results: the vote-live Worker on this account's workers.dev subdomain
VITE_LIVE_URL=https://vote-live.<subdomain>.workers.dev/results.json
